# Force CRLF line endings for all text files in MachineForge
* text=auto eol=crlf

# PowerShell files
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf

# Shell scripts
*.sh text eol=lf

# Configuration and Documentation
*.md text eol=crlf
*.json text eol=crlf
*.txt text eol=crlf
*.yml text eol=crlf
*.yaml text eol=crlf
.gitignore text eol=crlf
.gitattributes text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.zip binary
*.exe binary

# EditorConfig configuration for MachineForge
# https://editorconfig.org

root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Shell scripts

[*.sh]
end_of_line = lf

# PowerShell scripts, modules, and data files
[*.{ps1,psm1,psd1}]
indent_style = space
indent_size = 4

# Markdown files (preserve trailing spaces for line breaks if needed)
[*.md]
trim_trailing_whitespace = false

# Data and configuration markup
[*.{json,yml,yaml}]
indent_size = 2
